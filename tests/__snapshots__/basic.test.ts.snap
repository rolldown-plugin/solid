exports[`rolldown-plugin-solid src should transform component with hydratable option 1`] = `
"import { createComponent, delegateEvents, getNextElement, insert, render, runHydrationEvents, scope, template } from "@solidjs/web";
import { createSignal } from "solid-js";
var _tmpl$ = /* @__PURE__ */ template(\`<button type=button>\`);
const App = () => {
	const [count, setCount] = createSignal(0);
	const inc = (by = 1) => setCount(count() + by);
	var _el$ = getNextElement(_tmpl$);
	_el$.$$click = () => inc(1);
	insert(_el$, scope(() => {
		return count();
	}));
	runHydrationEvents();
	return _el$;
};
render(() => createComponent(App, {}), document.getElementById("app"));
delegateEvents(["click"]);
"
`;

