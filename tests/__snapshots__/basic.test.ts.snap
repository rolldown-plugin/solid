exports[`rolldown-plugin-solid src should transform basic SolidJS component 1`] = `
"import { createComponent, delegateEvents, insert, render, template } from "@solidjs/web";
import { createSignal } from "solid-js";
var _tmpl$ = /* @__PURE__ */ template(\`<button type=button>\`);
const App = () => {
	const [count, setCount] = createSignal(0);
	const inc = (by = 1) => setCount(count() + by);
	var _el$ = _tmpl$();
	_el$.$$click = () => inc(1);
	insert(_el$, count);
	return _el$;
};
render(() => createComponent(App, {}), document.getElementById("app"));
delegateEvents(["click"]);
"
`;

